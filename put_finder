import datetime
import math

import yfinance as yf

# Stocks to scan
DJI_TICKERS = [
    "AAPL", "AMGN", "AMZN", "AXP", "BA", "CAT", "CRM", "CSCO", "CVX", "DIS",
    "GOOGL", "GS", "HD", "HON", "IBM", "JNJ", "JPM", "KO", "MCD", "MMM",
    "MRK", "MSFT", "NKE", "NVDA", "PG", "SHW", "TRV", "UNH", "V", "WMT"
]

# Strategy settings
MIN_DAYS, MAX_DAYS = 30, 45
MIN_DELTA, MAX_DELTA = 0.20, 0.30
MIN_VOLUME = 100
MIN_OPEN_INTEREST = 500


def normal_cdf(x):
    return 0.5 * (1 + math.erf(x / math.sqrt(2)))


def calculate_put_delta(stock_price, strike, days, volatility):
    """Calculate approximate Black-Scholes put Delta."""
    if stock_price <= 0 or strike <= 0 or volatility <= 0 or days <= 0:
        return 0

    time = days / 365
    d1 = (
        math.log(stock_price / strike) + (0.5 * volatility**2) * time
    ) / (volatility * math.sqrt(time))

    return abs(normal_cdf(d1) - 1)


def find_best_put():
    today = datetime.date.today()
    best_put = None
    best_score = 0

    print("Scanning Dow Jones stocks...\n")

    for symbol in DJI_TICKERS:
        try:
            stock = yf.Ticker(symbol)
            price = stock.fast_info["lastPrice"]

            for expiration in stock.options:
                expiration_date = datetime.date.fromisoformat(expiration)
                days = (expiration_date - today).days

                if not (MIN_DAYS <= days <= MAX_DAYS):
                    continue

                puts = stock.option_chain(expiration).puts

                for _, put in puts.iterrows():
                    strike = put["strike"]
                    bid = put["bid"]
                    ask = put["ask"]
                    iv = put["impliedVolatility"]
                    volume = put["volume"]
                    open_interest = put["openInterest"]

                    # Basic validation & liquidity filters
                    if strike <= 0 or bid <= 0 or ask <= 0 or iv <= 0:
                        continue
                    if volume < MIN_VOLUME or open_interest < MIN_OPEN_INTEREST:
                        continue

                    # Delta evaluation
                    delta = calculate_put_delta(price, strike, days, iv)
                    if not (MIN_DELTA <= delta <= MAX_DELTA):
                        continue

                    # Scoring
                    premium = bid
                    annualized_yield = (premium / strike) * (365 / days)
                    score = annualized_yield / iv

                    if score > best_score:
                        best_score = score
                        best_put = {
                            "ticker": symbol,
                            "stock_price": round(price, 2),
                            "expiration": expiration,
                            "strike": strike,
                            "premium": round(premium, 2),
                            "days": days,
                            "delta": round(delta, 3),
                            "iv": f"{iv * 100:.1f}%",
                            "annual_return": f"{annualized_yield * 100:.2f}%",
                            "score": round(score, 4),
                            "volume": int(volume),
                            "open_interest": int(open_interest),
                            "collateral_required": strike * 100,
                            "premium_collected": round(premium * 100, 2),
                        }

        except Exception as e:
            print(f"{symbol}: {e}")

    return best_put


if __name__ == "__main__":
    result = find_best_put()

    print("\n=== BEST WHEEL PUT ===")
    if result:
        for name, value in result.items():
            print(f"{name.replace('_', ' ').title():<22}: {value}")
    else:
        print("No suitable put options found.")
